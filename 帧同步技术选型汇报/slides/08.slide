      <Box style={{ width: 480, justifyContent: 'space-between' }}>
        <Box style={{ height: 88, background: '#E6EDF5', borderLeft: '3px solid #1A3358', padding: 16, justifyContent: 'center' }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A3358' }}>状态同步服务器要持有 World</Text>
          <Text style={{ fontSize: 16, color: '#26282E', lineHeight: 1.5, marginTop: 4 }}>权威端持有组件并算 delta</Text>
        </Box>
        <Box style={{ height: 88, background: '#E6EDF5', borderLeft: '3px solid #1A3358', padding: 16, justifyContent: 'center' }}>
