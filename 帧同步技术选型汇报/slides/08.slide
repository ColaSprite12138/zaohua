          <Text style={{ fontSize: 16, color: '#666666', lineHeight: 1.5, marginTop: 4 }}>规则在两端各自演算，无单点</Text>
        </Box>
        <Box style={{ height: 88, background: '#F4F4F4', borderLeft: '3px solid #234B80', padding: 16, justifyContent: 'center' }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#234B80' }}>一进程带多房</Text>
          <Text style={{ fontSize: 16, color: '#666666', lineHeight: 1.5, marginTop: 4 }}>算力开销与房间数弱相关</Text>
