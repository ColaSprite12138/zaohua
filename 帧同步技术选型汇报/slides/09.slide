<Slide style={{ padding: '60px', background: '#FFFFFF' }}>
  <Box style={{ height: 62 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#26282E', lineHeight: 1.25 }}>上行只送输入，全帧历史让回放与争议复盘零成本</Text>
    <Box style={{ height: 1, width: '100%', background: '#D3DBE5', marginTop: 18 }} />
  </Box>
  <Box style={{ height: 470, marginTop: 24 }}>
    <Box style={{ height: 140, flexDirection: 'row', gap: 46 }}>
      <Box style={{ width: 255, background: '#1A3358', borderRadius: 8, padding: 18, justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 16, color: '#B5D4F4' }}>01 输入采集</Text>
        <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>只收操作</Text>
      </Box>
      <Box style={{ width: 255, background: '#234B80', borderRadius: 8, padding: 18, justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 16, color: '#D3DBE5' }}>02 帧钟贴帧</Text>
        <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>定长帧表</Text>
      </Box>
      <Box style={{ width: 255, background: '#4A73A8', borderRadius: 8, padding: 18, justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF' }}>03 全量历史</Text>
        <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>不裁窗口</Text>
      </Box>
      <Box style={{ width: 255, background: '#82A1C4', borderRadius: 8, padding: 18, justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF' }}>04 回放对账</Text>
        <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>过程可重演</Text>
      </Box>
    </Box>
    <Box style={{ height: 240, marginTop: 16, flexDirection: 'row', gap: 46 }}>
      <Box style={{ width: 255, padding: 16, background: '#F4F4F4', borderRadius: 8 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#234B80' }}>12 字节 / tick</Text>
        <Text style={{ fontSize: 16, color: '#666666', lineHeight: 1.55, marginTop: 10 }}>上行只送输入，无操作不发；成本与怪物、掉落、弹幕数量解耦</Text>
      </Box>
      <Box style={{ width: 255, padding: 16, background: '#F4F4F4', borderRadius: 8 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#234B80' }}>24Hz 统一帧钟</Text>
        <Text style={{ fontSize: 16, color: '#666666', lineHeight: 1.55, marginTop: 10 }}>缺帧补 EMPTY_STEP_INPUT；追帧按步数限流，不拿宿主 tick 当帧钟</Text>
      </Box>
      <Box style={{ width: 255, padding: 16, background: '#F4F4F4', borderRadius: 8 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#234B80' }}>180 tick 补帧窗</Text>
        <Text style={{ fontSize: 16, color: '#666666', lineHeight: 1.55, marginTop: 10 }}>frame-log 存服务器全量历史，120 tick 分块回传，不裁历史窗口</Text>
      </Box>
      <Box style={{ width: 255, padding: 16, background: '#F4F4F4', borderRadius: 8 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#234B80' }}>回放的是过程</Text>
        <Text style={{ fontSize: 16, color: '#666666', lineHeight: 1.55, marginTop: 10 }}>争议局可逐帧重演；状态同步要另存快照序列，且只能看结果</Text>
      </Box>
    </Box>
    <Box style={{ height: 44, marginTop: 14, background: '#E6EDF5', borderLeft: '4px solid #1A3358', paddingLeft: 20, justifyContent: 'center' }}>
      <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A3358' }}>所以：带宽、补帧、回放、观战共用同一份帧历史，不需要额外建一套系统。</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#666666' }}>依据：frame-log.ts / netResync 补帧机制</Text>
    <Text style={{ fontSize: 14, color: '#666666' }}>09 / 13</Text>
  </Box>
</Slide>
